# Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.

# ─── Application ──────────────────────────────────────────
APP_ENV=development
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# ─── API Settings ─────────────────────────────────────────
# Origins allowed to call the API (comma-separated).
# In development, use * or http://localhost:5500
# In production, use your GitHub Pages URL, e.g. https://username.github.io
CORS_ORIGINS=*

# Rate limit: requests per minute per IP (applies to POST /api/analyze)
RATE_LIMIT_PER_MINUTE=60

# Trust the X-Forwarded-For header when behind a trusted proxy
# (set to true when deploying on Render / behind a reverse proxy)
TRUST_PROXY_HEADERS=false

# ─── Model ────────────────────────────────────────────────
MODEL_PATH=models/phishing_model.joblib
FEATURE_NAMES_PATH=models/feature_names.json
MODEL_METADATA_PATH=models/model_metadata.json

# ─── Deterministic domain overrides ───────────────────────
# Trusted apex domain (e.g. google.com) -> cap phishing probability
WHITELIST_CONFIDENCE_CAP=0.05
# Brand-spoofing attempt (e.g. paypal.ab) -> floor phishing probability
BRAND_SPOOF_CONFIDENCE_FLOOR=0.95
