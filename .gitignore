# ─── Python ───────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
*.pyo

# Virtual environments
.venv/
venv/
env/
ENV/
.env

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
.eggs/

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# ─── Jupyter ──────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ─── Dataset (large files — download separately) ──────────
data/*.csv
data/*.zip
data/*.gz
data/*.parquet
data/*.json
!data/README.md

# ─── ML Model Artifacts ───────────────────────────────────
# The production model (models/phishing_model.joblib) is committed so that
# Render, Docker, and CI always have a usable artifact at build time.
# Retrain/regenerate it locally with: python scripts/rebuild_model.py
models/*.pkl

# ─── Environment Variables ────────────────────────────────
.env
.env.local
.env.production

# ─── IDE / Editor ─────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ─── OS ───────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Testing / Coverage ───────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/

# ─── Logs ─────────────────────────────────────────────────
*.log
logs/

# ─── Misc ─────────────────────────────────────────────────
*.tmp
*.bak
